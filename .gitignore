# .gitignore — Audio Notes Platform

# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/

# ─── Environment files (NEVER commit real secrets) ────────
.env
.env.local
.env.production
.env.*.local

# ─── Next.js ──────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.env.local

# ─── Node ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.iml
